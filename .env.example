# ------------------------------------------------------------------
# BandhanJodi OTP server — example environment file
# Copy this to `.env` and fill in your real values.
# NEVER commit the real .env to GitHub. Add ".env" to .gitignore.
# ------------------------------------------------------------------

# Server
PORT=5000

# Secret used to hash OTPs in memory. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_SECRET=replace_with_a_long_random_string

# OTP policy
OTP_TTL_MS=300000            # code valid for 5 minutes
RESEND_COOLDOWN_MS=30000     # 30s between resend requests
MAX_VERIFY_ATTEMPTS=5
MAX_SENDS_PER_HOUR=5         # per mobile/email
MAX_SENDS_PER_IP_HOUR=20

# Which browser origins may call this API (comma-separated).
# Put your real site origins here. "*" allows all (fine for testing only).
ALLOWED_ORIGINS=https://bandhanjodi.com,https://www.bandhanjodi.com,https://yourusername.github.io

# ------------------------------------------------------------------
# SMS delivery: console | twilio | msg91 | fast2sms
# ------------------------------------------------------------------
SMS_PROVIDER=console

# Twilio (global; India SMS also needs a DLT-registered sender)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# MSG91 (India) — needs a DLT-approved template/flow id
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_VAR_NAME=OTP

# Fast2SMS (India)
FAST2SMS_API_KEY=

# ------------------------------------------------------------------
# Email delivery: console | sendgrid | resend | smtp
# ------------------------------------------------------------------
EMAIL_PROVIDER=console

SENDGRID_API_KEY=
RESEND_API_KEY=

# SMTP (works with Gmail app-password, Zoho, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

MAIL_FROM=no-reply@bandhanjodi.com
MAIL_FROM_NAME=BandhanJodi
